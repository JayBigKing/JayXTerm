{
  "name": "jayxterm",
  "version": "0.5.4",
  "description": "A focused SSH and SFTP desktop client",
  "private": true,
  "author": "JayXTerm contributors",
  "main": "src/main.cjs",
  "productName": "JayXTerm",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "vite build --base=./ --outDir .codex-cache/build/renderer",
    "dev": "npm run build && electron .",
    "test": "node --test src/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron": "42.8.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.jayxterm.app",
    "productName": "JayXTerm",
    "directories": {
      "output": ".codex-cache/releases"
    },
    "files": [
      "src/main.cjs",
      "src/preload.cjs",
      "src/ssh-worker.cjs",
      "src/remote-text.cjs",
      "src/editor-windows.cjs",
      "src/editor-preload.cjs",
      "src/store.cjs",
      "src/transfers.cjs",
      ".codex-cache/build/renderer/**/*",
      "assets/jayxterm.png",
      "package.json",
      "LICENSE",
      "README.md",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*",
      "src/codec.cjs",
      "src/windows.cjs"
    ],
    "win": {
      "icon": "assets/jayxterm.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "JayXTerm-${version}-${arch}-setup.${ext}"
    },
    "npmRebuild": false,
    "portable": {
      "artifactName": "JayXTerm-${version}-${arch}-portable.${ext}"
    },
    "electronDownload": {
      "cache": ".codex-cache/electron"
    }
  }
}
